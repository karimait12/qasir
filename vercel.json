{
  "rewrites": [
    {
      "source": "/dashboard",
      "destination": "/index.html"
    },
    {
      "source": "/login",
      "destination": "/index.html"
    },
    {
      "source": "/:code([A-Za-z0-9_-]{3,32})",
      "destination": "/api/r?code=:code"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
